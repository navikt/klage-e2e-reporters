{
  "name": "@navikt/klage-e2e-reporters",
  "version": "2.1.2",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./slack": {
      "types": "./dist/slack-reporter.d.mts",
      "default": "./dist/slack-reporter.mjs"
    },
    "./status": {
      "types": "./dist/status-reporter.d.mts",
      "default": "./dist/status-reporter.mjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bun node_modules/.bin/tsdown",
    "test": "bun test",
    "report:slack": "bun src/slack-reporter/test/report.ts",
    "clean:slack": "bun src/slack-reporter/test/cleanup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "knip": "knip"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1"
  },
  "dependencies": {
    "@slack/types": "3.2.0",
    "@slack/web-api": "8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.1",
    "knip": "6.39.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
